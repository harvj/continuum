<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title><%= @section.capitalize %> · Continuum</title>
    <% if @favicons.empty? %>
      <link rel="icon" type="image/svg+xml" sizes="any" href="<%= LandingController::NEUTRAL_FAVICON_PATH %>">
    <% else %>
      <% @favicons.each do |icon| %>
        <%= tag.link rel: "icon", href: favicon_path(icon), type: icon.media_type,
          sizes: ("any" if icon.media_type == "image/svg+xml") %>
      <% end %>
    <% end %>
    <link rel="stylesheet" href="/continuum.css">
    <% if @auth_session %>
      <link rel="stylesheet" href="/shell-session.css">
      <script src="/shell-session.js" defer></script>
    <% end %>
    <% if @background || @backgrounds %>
      <script src="/site-art.js" defer></script>
    <% end %>
  </head>
  <body class="<%= @section %>">
    <% if @background %>
      <%= tag.img class: "background", src: "/background/#{@background.digest}", alt: "", aria: { hidden: true },
        data: { art_presentation: @background.presentation, art_legacy: @background.foreground }.compact %>
    <% end %>
    <% @backgrounds&.each do |mode, asset| %>
      <template data-art-mode="<%= mode %>">
        <%= tag.img class: "background", src: "/background/#{asset.digest}", alt: "", aria: { hidden: true },
          data: { art_presentation: asset.presentation, art_legacy: asset.foreground }.compact %>
      </template>
    <% end %>
    <% if @backgrounds %>
      <details class="appearance" hidden>
        <summary aria-label="Appearance settings"><span aria-hidden="true">◐</span></summary>
        <fieldset>
          <legend>Appearance</legend>
          <% %w[system light dark].each do |mode| %>
            <label><%= tag.input type: "radio", name: "appearance", value: mode, checked: mode == "system" %> <%= mode.capitalize %></label>
          <% end %>
        </fieldset>
      </details>
    <% end %>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header data-art-role="top">
      <a class="wordmark" href="https://harvj.com">harvj.</a>
      <nav aria-label="Primary">
        <% LandingController::SECTIONS.each do |section| %>
          <%= link_to section.capitalize, "https://#{section}.harvj.com/", aria: { current: ("page" if @section == section) } %>
        <% end %>
      </nav>
      <% if @auth_session %>
        <%= render "session_dropdown", auth_session: @auth_session, registration: @auth_registration %>
      <% end %>
    </header>
    <main id="main-content" tabindex="-1" data-art-role="default" aria-label="<%= @section.capitalize %>"></main>
    <footer data-art-role="bottom"><span>© <%= Date.current.year %> <%= link_to "Jim Harvey", "https://harvj.com" %></span>
      <span class="release-version">Continuum v<%= Rails.application.config.x.version %></span></footer>
  </body>
</html>
